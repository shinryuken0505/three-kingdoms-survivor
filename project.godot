; Engine configuration file.
; Generated for Godot 4.7+

config_version=5

[application]
config/name="三國人生錄：亂世倖存 V2.0.0-alpha.21"
run/main_scene="res://main.tscn"
config/icon="res://assets/icon.png"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/size/min_width=1024
window/size/min_height=576
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[audio]
default_bus_layout="res://default_bus_layout.tres"

[internationalization]
locale/translations=PackedStringArray("res://localization/game.zh_TW.po", "res://localization/game.zh_CN.po", "res://localization/game.en.po", "res://localization/game.ja.po")
locale/fallback="zh_TW"
