; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters here are not all obvious.
;
; Format:
;   [section] ; section between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="三國人生錄：亂世倖存 V2.0.0-alpha.57"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.png"

[autoload]

GameEvents="*res://scripts/core/game_event_bus.gd"
Alpha48RuntimeCoordinator="*res://scripts/core/alpha48_runtime_coordinator.gd"

[audio]

default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/size/min_width=1024
window/size/min_height=576

[internationalization]

locale/translations=PackedStringArray("res://localization/game.zh_TW.po", "res://localization/game.zh_CN.po", "res://localization/game.en.po", "res://localization/game.ja.po")
locale/fallback="zh_TW"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
